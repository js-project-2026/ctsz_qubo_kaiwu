# Copy to .env if you load env files yourself, or export in the shell.
# .env is gitignored; do not commit real local paths.

# Folder that contains qubo_model.py (optional if you run from the repo).
# QUBO_REPO_DIR=/path/to/qubo

# Folder that contains GEO GSE308682 10x files:
#   GSE308682_filtered_matrix.mtx.gz
#   GSE308682_filtered_features.tsv.gz
#   GSE308682_filtered_barcodes.tsv.gz
#   GSE308682_feature_reference.csv.gz
QUBO_DATA_DIR=/path/to/gse308682_dir

# Ocean TabuSampler. timeout_ms is per read but is NOT a hard interrupt of
# greedy descent on a numerically flat Q (typical near α* at p=5000).
# QUBO_TABU_TIMEOUT_MS=8000
# QUBO_TABU_WALLCLOCK_S=120
# QUBO_TABU_NUM_RESTARTS=0
